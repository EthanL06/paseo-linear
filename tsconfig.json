{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "react"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "index.server.ts",
    "index.client.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "client/**/*.ts",
    "client/**/*.tsx",
    "linear.test.ts"
  ]
}
